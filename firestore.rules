rules_version = '2';

// Money Grid: Firestore security rules.
//
// Everything lives under users/{uid}/. A signed-in user can read and write only their own subtree.
// Writes are validated: exact field sets, types, allowed values and sizes. Anything not matched
// below is denied. The values listed here must match src/types/ (a test checks they do).
// These rules never call get() or exists(), so they add no billed reads.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Access ----------

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ---------- Value checks ----------

    function isText(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // "YYYY-MM-DD" calendar date
    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    // ISO 8601 timestamp, e.g. 2026-11-17T09:30:00.000Z
    function isTimestamp(v) {
      return v is string
        && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$');
    }

    // Money in minor units (paise, cents): a whole number, never negative.
    function isMoney(v) {
      return v is int && v >= 0 && v <= 100000000000;
    }

    function isPositiveMoney(v) {
      return isMoney(v) && v > 0;
    }

    function isCurrency(v) {
      return v in ['INR', 'USD', 'EUR', 'GBP'];
    }

    // ---------- Subscriptions ----------

    function validSubscription(d, id) {
      return d.keys().hasOnly([
          'id', 'name', 'provider', 'category', 'amountMinor', 'currency', 'billingCycle', 'startDate',
          'nextPaymentDate', 'paymentMethod', 'status', 'reminderDays', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll([
          'id', 'name', 'provider', 'category', 'amountMinor', 'currency', 'billingCycle', 'startDate',
          'nextPaymentDate', 'paymentMethod', 'status', 'reminderDays', 'createdAt', 'updatedAt'
        ])
        && d.id == id
        && isText(d.name, 1, 80)
        && isText(d.provider, 0, 80)
        && d.category in ['Entertainment', 'Music', 'Productivity', 'Software', 'Education', 'Shopping',
                          'Fitness', 'Cloud Services', 'Gaming', 'Other']
        && isPositiveMoney(d.amountMinor)
        && isCurrency(d.currency)
        && d.billingCycle in ['weekly', 'monthly', 'quarterly', 'half-yearly', 'yearly']
        && isDate(d.startDate)
        && isDate(d.nextPaymentDate)
        && isText(d.paymentMethod, 0, 80)
        && d.status in ['active', 'paused', 'cancelled', 'expired']
        && d.reminderDays in [1, 3, 7, 30]
        && isTimestamp(d.createdAt)
        && isTimestamp(d.updatedAt);
    }

    // ---------- Payments and premiums ----------
    // Payment history is never rewritten: once a payment is paid or skipped it cannot be changed
    // (only deleted, when the whole subscription or policy is deleted).

    function validPayment(d, id, ownerField) {
      return d.keys().hasOnly(['id', ownerField, 'amountMinor', 'currency', 'dueDate', 'paymentDate', 'status',
                               'notes', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['id', ownerField, 'amountMinor', 'currency', 'dueDate', 'paymentDate', 'status',
                            'notes', 'createdAt', 'updatedAt'])
        && d.id == id
        && isText(d[ownerField], 1, 100)
        && isPositiveMoney(d.amountMinor)
        && isCurrency(d.currency)
        && isDate(d.dueDate)
        && (d.paymentDate == null || isDate(d.paymentDate))
        && d.status in ['upcoming', 'paid', 'skipped']
        && isText(d.notes, 0, 500)
        && isTimestamp(d.createdAt)
        && isTimestamp(d.updatedAt)
        // Only a paid payment has a payment date.
        && ((d.status == 'paid') == (d.paymentDate != null));
    }

    function paymentUpdateAllowed(ownerField) {
      return resource.data.status == 'upcoming'
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data[ownerField] == resource.data[ownerField];
    }

    // ---------- Policies ----------

    function validPolicy(d, id) {
      return d.keys().hasOnly([
          'id', 'provider', 'policyName', 'policyType', 'policyNumber', 'premiumAmountMinor', 'currency',
          'coverageAmountMinor', 'billingCycle', 'startDate', 'expiryDate', 'nextPremiumDate', 'status',
          'reminderDays', 'notes', 'renewals', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll([
          'id', 'provider', 'policyName', 'policyType', 'policyNumber', 'premiumAmountMinor', 'currency',
          'coverageAmountMinor', 'billingCycle', 'startDate', 'expiryDate', 'nextPremiumDate', 'status',
          'reminderDays', 'notes', 'renewals', 'createdAt', 'updatedAt'
        ])
        && d.id == id
        && isText(d.provider, 1, 80)
        && isText(d.policyName, 1, 80)
        && d.policyType in ['health', 'vehicle', 'life', 'home', 'travel', 'other']
        && isText(d.policyNumber, 0, 60)
        && isPositiveMoney(d.premiumAmountMinor)
        && isCurrency(d.currency)
        && isMoney(d.coverageAmountMinor)
        && d.billingCycle in ['monthly', 'quarterly', 'half-yearly', 'yearly']
        && isDate(d.startDate)
        && isDate(d.expiryDate)
        && d.expiryDate > d.startDate
        && (d.nextPremiumDate == null || isDate(d.nextPremiumDate))
        && d.status in ['active', 'cancelled']
        && d.reminderDays in [7, 15, 30, 60, 90]
        && isText(d.notes, 0, 1000)
        && d.renewals is list && d.renewals.size() <= 200
        && isTimestamp(d.createdAt)
        && isTimestamp(d.updatedAt);
    }

    // ---------- Notifications and activity ----------

    function validNotification(d, id) {
      return d.keys().hasOnly(['id', 'kind', 'title', 'description', 'relatedType', 'relatedId', 'createdAt',
                               'read', 'readAt'])
        && d.keys().hasAll(['id', 'kind', 'title', 'description', 'relatedType', 'relatedId', 'createdAt',
                            'read', 'readAt'])
        && d.id == id
        && d.kind in ['subscription_due', 'premium_due', 'policy_expiring', 'payment_overdue', 'payment_paid']
        && isText(d.title, 1, 200)
        && isText(d.description, 0, 500)
        && d.relatedType in ['subscription', 'policy']
        && (d.relatedId == null || isText(d.relatedId, 1, 100))
        && isTimestamp(d.createdAt)
        && d.read is bool
        && (d.readAt == null || isTimestamp(d.readAt));
    }

    // A notification can be marked read, or lose its link to a deleted record. Nothing else changes.
    function notificationUpdateAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'relatedId']);
    }

    function validActivity(d, id) {
      return d.keys().hasOnly(['id', 'kind', 'message', 'relatedType', 'relatedId', 'createdAt'])
        && d.keys().hasAll(['id', 'kind', 'message', 'relatedType', 'relatedId', 'createdAt'])
        && d.id == id
        && d.kind in ['subscription_added', 'subscription_updated', 'subscription_status', 'subscription_deleted',
                      'subscription_payment', 'policy_added', 'policy_updated', 'policy_status', 'policy_renewed',
                      'policy_deleted', 'policy_payment']
        && isText(d.message, 1, 300)
        && d.relatedType in ['subscription', 'policy']
        && (d.relatedId == null || isText(d.relatedId, 1, 100))
        && isTimestamp(d.createdAt);
    }

    // ---------- Profile and settings ----------

    function validProfile(d, uid) {
      return d.keys().hasOnly(['id', 'uid', 'fullName', 'email', 'photoURL', 'preferredCurrency', 'timeZone', 'createdAt'])
        && d.keys().hasAll(['id', 'uid', 'fullName', 'email', 'preferredCurrency', 'timeZone', 'createdAt'])
        && d.id == 'details'
        // The profile always belongs to, and carries the email of, the signed-in account.
        && d.uid == uid
        && d.email == request.auth.token.email
        && isText(d.fullName, 1, 80)
        && (!('photoURL' in d) || isText(d.photoURL, 0, 2000))
        && isCurrency(d.preferredCurrency)
        && isText(d.timeZone, 1, 64)
        && isTimestamp(d.createdAt);
    }

    function validPreferences(d) {
      return d.keys().hasOnly(['id', 'inAppNotifications', 'premiumReminderDays'])
        && d.keys().hasAll(['id', 'inAppNotifications', 'premiumReminderDays'])
        && d.id == 'preferences'
        && d.inAppNotifications is bool
        && d.premiumReminderDays in [1, 3, 7, 15, 30];
    }

    // ---------- Collections ----------

    match /users/{uid} {

      match /subscriptions/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validSubscription(request.resource.data, id);
        allow update: if isOwner(uid) && validSubscription(request.resource.data, id)
                      && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(uid);
      }

      match /subscriptionPayments/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validPayment(request.resource.data, id, 'subscriptionId');
        allow update: if isOwner(uid) && validPayment(request.resource.data, id, 'subscriptionId')
                      && paymentUpdateAllowed('subscriptionId');
        allow delete: if isOwner(uid);
      }

      match /policies/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validPolicy(request.resource.data, id);
        allow update: if isOwner(uid) && validPolicy(request.resource.data, id)
                      && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(uid);
      }

      match /policyPayments/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validPayment(request.resource.data, id, 'policyId');
        allow update: if isOwner(uid) && validPayment(request.resource.data, id, 'policyId')
                      && paymentUpdateAllowed('policyId');
        allow delete: if isOwner(uid);
      }

      match /notifications/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validNotification(request.resource.data, id);
        allow update: if isOwner(uid) && validNotification(request.resource.data, id) && notificationUpdateAllowed();
        allow delete: if isOwner(uid);
      }

      // The activity log is append-only.
      match /activity/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validActivity(request.resource.data, id);
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      match /profile/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && id == 'details' && validProfile(request.resource.data, uid);
        allow update: if isOwner(uid) && id == 'details' && validProfile(request.resource.data, uid)
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.email == resource.data.email;
        allow delete: if false;
      }

      match /settings/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && id == 'preferences' && validPreferences(request.resource.data);
        allow delete: if isOwner(uid);
      }
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
