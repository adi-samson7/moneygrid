# Copy this file to .env.local and fill it in. .env.local is git-ignored and never committed.
#
# Leave VITE_BACKEND unset to run entirely in the browser (mock sign-in, localStorage). This is the
# default for `npm run dev` and for the tests.
#
# To use Firebase, set VITE_BACKEND=firebase and fill in the values below from the Firebase console:
#   Project settings > General > Your apps > Web app > SDK setup and configuration.
# These values are not secrets (they identify your project; the Firestore security rules protect the
# data), but keep them in environment variables rather than in the code.

VITE_BACKEND=firebase

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to true to use the local emulators instead (see `npm run dev:emulator`). No Firebase account needed.
# VITE_USE_EMULATORS=true
